# The backend is a separate repo. Start it first: cd ../backend && make up
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Reverb, as the BROWSER reaches it. The API reaches the same server by its
# compose hostname on the internal network, so the backend's REVERB_HOST and
# REVERB_PORT are different values for the same thing. REVERB_PORT below must
# track the backend's REVERB_HOST_PORT — the host-side mapping — not its
# REVERB_PORT, which is container-side.
#
# The app key identifies the application in the socket handshake and is meant
# to reach the client. It is not a secret; the app SECRET never leaves the
# server, and joining a private channel needs a signed /broadcasting/auth
# response only the server can produce.
NUXT_PUBLIC_REVERB_KEY=pr-local-app-key
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
